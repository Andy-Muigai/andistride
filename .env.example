# Copy to .env (or add as environment variables on Render). NEVER commit real values.

# manual = customer pays NCBA paybill 880100 / account 849292 and sends the code on WhatsApp
# stk    = automatic M-Pesa prompt (needs your OWN Safaricom paybill + Daraja go-live)
PAYMENT_MODE=manual

# Secret for /api/admin/orders?token=...
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Only needed when PAYMENT_MODE=stk ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
PUBLIC_URL=https://andistride.onrender.com
TEST_AMOUNT=1

PORT=3000
